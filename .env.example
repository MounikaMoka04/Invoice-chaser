# Copy to .env and edit. Every value has a safe default, so the app runs without a .env.

# --- Database -------------------------------------------------------------
# SQLite is the zero-setup default. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice_chaser
DATABASE_URL=sqlite:///./invoice_chaser.db

# --- Auth -----------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

# --- LLM (template = no API key needed, fixed wording) ----------------------
# one of: template | gemini | groq
LLM_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- WhatsApp (mock = print to the log, nothing is sent) ---------------------
# one of: mock | cloud
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=
# Name and language of the approved reminder template (used outside the 24h window)
WHATSAPP_TEMPLATE_NAME=invoice_reminder
WHATSAPP_TEMPLATE_LANG=en

# --- Agent rules ------------------------------------------------------------
TIMEZONE=Asia/Kolkata
QUIET_START_HOUR=21
QUIET_END_HOUR=9
MAX_REMINDERS=5
MIN_GAP_DAYS=2
MAX_MESSAGES_PER_CLIENT_PER_WEEK=3
REQUIRE_APPROVAL=false

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_HOURS=10,16
